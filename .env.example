# Database Configuration - REQUIRED! No default fallback
# Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_NOW
DATABASE_URL=postgresql://postgres:CHANGE_THIS_TO_STRONG_PASSWORD_NOW@postgres:5432/govtjobsnow

# Database Connection Details
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_NOW
PGDATABASE=govtjobsnow

# Application Configuration
NODE_ENV=production
PORT=5000
TZ=Asia/Kolkata

# Optional: Enable test scraping (only for development)
# ENABLE_TEST_SCRAPE=true

# Optional: Admin configuration (if you're using admin features)
# ADMIN_SECRET_KEY=your_admin_secret_key_here
# JWT_SECRET=your_jwt_secret_here

# Optional: External API keys (if you're using any external services)
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# SEO / BLOG SYSTEM (New)
# ============================================================

# Base URL (used for sitemap, IndexNow, and meta injection)
BASE_URL=https://govtjobnow.com

# AI / LLM API Keys
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIzaSy...

# Search Engine Webmaster Verification (injected as meta tags on all pages)
GOOGLE_SITE_VERIFICATION=your_google_search_console_verification_token
BING_SITE_VERIFICATION=your_bing_webmaster_verification_token

# IndexNow API — generate a UUID for your key:
# Run: node -e "const {randomUUID}=require('crypto');console.log(randomUUID())"
INDEXNOW_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Session Security
SESSION_SECRET=a_very_long_random_string_here